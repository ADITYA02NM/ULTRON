# Local backup of original ULTRON version (pre-IoT redirect)
ULTRON(SEN3)/

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Editors
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Node
node_modules/
dist/

# PlatformIO build artefacts (regenerated by `pio run`; large, never commit)
.pio/

# Screenshots (evidence, not source)
dashboard/web/screenshots/
dashboard/cp5_*.png

# Auth database (contains credentials, sessions — never commit)
auth.db
auth.db-shm
auth.db-wal

# TLS keys and CA (private keys never go into git)
*.key
ca/
certs/

# Wheelhouse (offline pip packages, too large for git)
wheelhouse/

# Dev launcher artefacts (local state, never commit)
dev-evidence.db
dev-evidence.db-shm
dev-evidence.db-wal
auth.db.bak.*
.demo-code

# Notification credentials (copy from .notify.example; never commit)
.notify

# Secrets (copy from .env.example; never commit)
.env

# Firmware WiFi/MQTT credentials (copy from secrets.example.h; never commit).
# config.h itself is tracked and must stay credential-free.
firmware/**/secrets.h
