# ULTRON secrets — copy to .env and fill in.
#
#   cp .env.example .env
#   chmod 600 .env
#
# .env is gitignored. Your Gmail app password belongs here and nowhere else.
# These are ULTRON_* environment variables, so the values you set here win over
# anything in .notify — the file is for config, this file is for secrets.
#
# Gmail app password:  https://myaccount.google.com/apppasswords
#   2-Step Verification must be ON or that page does not exist.
#   16 letters. Google shows them in 4 groups; paste without the spaces.
#   Quote the value — it is a string, not shell.

ULTRON_SMTP_PASS=''
